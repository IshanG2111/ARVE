{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.90.0",
          "informationUri": "https://semgrep.dev/",
          "rules": [
            {
              "id": "arve.python.sql-injection",
              "name": "arve.python.sql-injection",
              "shortDescription": {
                "text": "SQL Injection Risk"
              },
              "fullDescription": {
                "text": "User input concatenated directly into SQL query string."
              },
              "helpUri": "https://owasp.org/www-community/attacks/SQL_Injection",
              "properties": {
                "metadata": {
                  "cwe": [
                    "CWE-89: SQL Injection"
                  ],
                  "owasp": [
                    "A03:2021 - Injection"
                  ],
                  "confidence": "HIGH",
                  "category": "security",
                  "technology": [
                    "python",
                    "sqlite"
                  ],
                  "references": [
                    "https://owasp.org/www-community/attacks/SQL_Injection"
                  ]
                }
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "arve.python.sql-injection",
          "level": "error",
          "message": {
            "text": "User input concatenated directly into SQL query string."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/users.py"
                },
                "region": {
                  "startLine": 42,
                  "startColumn": 5,
                  "endLine": 42,
                  "endColumn": 45
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
