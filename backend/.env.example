# Runtime environment: dev enables explicit mock/demo paths for local testing.
# Use production in deployed environments.
ARVE_ENV=dev

JWT_SECRET=generate_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arve_db

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email repo

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON=your_firebase_service_account_json

# Phase 3 scan orchestration (non-secret configuration)
DOCKER_BINARY=docker
SCANNER_MEMORY_LIMIT=1g
SCANNER_CPU_LIMIT=1.5
SCANNER_CONTAINER_USER=1000:1000
SCANNER_ENGINE_TIMEOUT_SECONDS=180
SCANNER_GLOBAL_TIMEOUT_SECONDS=600
SCANNER_LOG_MAX_CHARS=8000

# Phase 3 async job queue (non-secret configuration)
SCAN_QUEUE_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# Phase 3 Docker smoke test. Keep false for normal/production runs.
SCANNER_ENABLE_TEST_ENGINE=false
SCANNER_TEST_IMAGE=arve-phase3-test-scanner:latest
SCANNER_TEST_MODE=success

# Phase 4A Security Scanner Engines
SCANNER_ENABLE_OSV=true
SCANNER_OSV_IMAGE=ghcr.io/google/osv-scanner:v1.9.2
SCANNER_ENABLE_GITLEAKS=true
SCANNER_GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.24.2
SCANNER_ENABLE_SEMGREP=true
SCANNER_SEMGREP_IMAGE=semgrep/semgrep:1.90.0
SCANNER_SEMGREP_CONFIG=auto
SCANNER_NETWORK_MODE=none
SCANNER_OSV_NETWORK=bridge
SCANNER_SEMGREP_NETWORK=none

# Backblaze B2 cloud artifact storage. Credentials are secrets and must be supplied via Infisical.
B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
B2_REGION=<your-region>
B2_BUCKET_NAME=<your-bucket-name>
B2_ACCESS_KEY_ID=<your key id>
B2_SECRET_ACCESS_KEY=<your application key>