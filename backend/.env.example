# Runtime environment: dev enables explicit mock/demo paths for local testing.
# Use production in deployed environments.
ARVE_ENV=dev

# GitHub OAuth credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email repo

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend & Database
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arve_db

# Scan Queue Backend (celery or background)
SCAN_QUEUE_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# AI Integration (Groq Provider)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Scanner Container Limits & Timeouts
DOCKER_BINARY=docker
SCANNER_MEMORY_LIMIT=1g
SCANNER_CPU_LIMIT=1.5
SCANNER_CONTAINER_USER=1000:1000
SCANNER_ENGINE_TIMEOUT_SECONDS=180
SCANNER_GLOBAL_TIMEOUT_SECONDS=1500
SCANNER_LOG_MAX_CHARS=8000

# Phase 4A Security Scanner Engines
SCANNER_ENABLE_OSV=true
SCANNER_OSV_IMAGE=ghcr.io/google/osv-scanner:v1.9.2
SCANNER_ENABLE_GITLEAKS=true
SCANNER_GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.24.2
SCANNER_ENABLE_SEMGREP=true
SCANNER_SEMGREP_IMAGE=semgrep/semgrep:1.90.0
SCANNER_SEMGREP_CONFIG=auto
SCANNER_ENABLE_CODEQL=true
SCANNER_CODEQL_IMAGE=arve-codeql:2.27.1
SCANNER_CODEQL_QUERY_SUITE=security-extended
SCANNER_CODEQL_MEMORY_LIMIT=4g
SCANNER_CODEQL_CPU_LIMIT=2.0
SCANNER_CODEQL_RAM_MB=2048
SCANNER_CODEQL_TIMEOUT_SECONDS=1200
SCANNER_NETWORK_MODE=none
SCANNER_OSV_NETWORK=bridge
SCANNER_SEMGREP_NETWORK=none

# Optional Docker smoke test (keep false for normal/production runs)
SCANNER_ENABLE_TEST_ENGINE=false
SCANNER_TEST_IMAGE=arve-phase3-test-scanner:latest
SCANNER_TEST_MODE=success

# Backblaze B2 Cloud Artifact Storage (Optional)
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_REGION=us-west-000
B2_BUCKET_NAME=arve-artifacts
B2_ACCESS_KEY_ID=your_key_id
B2_SECRET_ACCESS_KEY=your_application_key
